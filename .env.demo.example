# Copy this file to .env at the repository root. Never commit the copied .env.
# This base profile runs the Oakland demo at stage speed without spending model credits.
SCENARIO_DIR=simulation/scenarios/pittsburgh_oakland
SMART_CITY_PROVIDER=mock
AGENT_PROVIDER=mock
EPISODE_ANALYST=mock
SIM_SPEED=16
SCENARIO_WORKERS=4
# Keep the live city near the branch snapshot while analysis runs; it returns to 16x afterward.
ANALYSIS_LIVE_SPEED=1
EPISODE_FALLBACK_TO_MOCK=true
EPISODE_PAUSE_ON_FINISH=true
AGENT_MAY_IMPLEMENT=true
MEMORY_ENABLED=true

# Claude credentials. The console can select Claude at runtime when these are configured.
# ANTHROPIC_API_KEY=your-anthropic-api-key
# Organization-level keys also require the workspace id shown in the Anthropic Console;
# a workspace-scoped key can leave this unset.
# ANTHROPIC_WORKSPACE_ID=your-anthropic-workspace-id
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Nemotron credentials. The console can select Nemotron at runtime when these are configured.
# NVIDIA_API_KEY=your-nvidia-api-key
# NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# EPISODE_ANALYST is only the startup selection. Keep mock above for a credit-free boot,
# then choose Mock, Claude or Nemotron in the Autonomous agent panel.
# For a provider qualification run, use false so an analyst or reviewer failure cannot look successful.
# EPISODE_FALLBACK_TO_MOCK=false
