# Copy to .env at the repository root. Only API keys are read from the environment.
# Nemotron is the analyst in code; without NVIDIA_API_KEY its calls fail visibly (no Mock fallback).

# ANTHROPIC_API_KEY=your-anthropic-api-key
# Only for an organization-level Anthropic key; a workspace-scoped key leaves it unset.
# ANTHROPIC_WORKSPACE_ID=your-anthropic-workspace-id
# NVIDIA_API_KEY=your-nvidia-api-key
