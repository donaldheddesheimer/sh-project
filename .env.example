# Copy to .env (repo root or backend/) to override defaults.

# Browser origins allowed to call the API and open /ws/state. Comma-separated or a JSON
# list; add the frontend's deployed origin when the two are hosted apart (Vercel + Cloud Run).
# CORS_ORIGINS=http://localhost:5173,https://my-app.vercel.app

# Where incidents come from (mock | nvidia) and who proposes responses (mock | nemotron).
SMART_CITY_PROVIDER=mock
AGENT_PROVIDER=mock

# Live simulation: speed multiple of wall-clock time, warm-up so roads are populated
# at start/reset, and the maximum WebSocket frame rate.
SIM_SPEED=4
SIM_WARMUP_S=300
SIM_AUTOSTART=true
BROADCAST_HZ=8
# Open sumo-gui for the live run (debugging).
SUMO_GUI=false
# Which city to simulate: downtown_grid (default; the tests always use it) or pittsburgh_oakland.
# Relative paths are taken from the repo root.
# SCENARIO_DIR=simulation/scenarios/pittsburgh_oakland

# Scenario analysis ("Analyze Response"): simulated seconds per branch (when the request
# omits it), parallel SUMO branches, timeline sample interval, candidate cap (including
# the baseline) and runs kept for GET /api/scenarios.
SCENARIO_HORIZON_S=600
SCENARIO_WORKERS=4
SCENARIO_SAMPLE_S=30
SCENARIO_MAX_CANDIDATES=9
SCENARIO_HISTORY=10
# An MCP-driven analysis is failed (releasing the one-run lock) after this many wall-clock
# seconds without a tool call.
SCENARIO_IDLE_TIMEOUT_S=300

# Defaults to the SUMO bundled with the eclipse-sumo wheel.
# SUMO_BINARY=/path/to/sumo

# Twin engine. Live simulation speed (a multiple of wall-clock time, above 0 and at most 64)
# held while an analysis is open, so the branches get more of the machine. Unset leaves the
# speed alone; changing the speed in the console while a run is open always wins, and that
# choice is kept afterwards.
# ANALYSIS_LIVE_SPEED=1

# Mock Smart City provider: simulated seconds between a crash and its detection.
INCIDENT_DETECTION_DELAY_S=4

# Autonomous demo episode. DEMO_SCRIPT arms a demos/*.json script at startup (operator-collision,
# crash-ahead, crash-already, double-crash, varied-crash); POST /api/demo/start does the same at runtime.
# operator-collision schedules nothing and waits for the console's Inject collision button.
# DEMO_SCRIPT=crash-ahead
# Startup analyst only; switch among configured Mock, Claude and Nemotron providers in the console.
# auto prefers configured Claude, then Nemotron, then mock to avoid spending NVIDIA credits by surprise.
EPISODE_ANALYST=auto
# Simulated seconds an applied plan is watched (default: the script's monitor_s, else the
# analysis horizon).
# EPISODE_MONITOR_S=600
# Wall-clock limit for one Claude or Nemotron analysis.
EPISODE_AGENT_TIMEOUT_S=300
# Let the mock analyst or reviewer take over when the selected model fails.
EPISODE_FALLBACK_TO_MOCK=true
# Pause the live simulation when an episode completes (live collection stops).
EPISODE_PAUSE_ON_FINISH=true
# Let the agent apply its own recommendation to the live city (MCP implement_recommendation).
# The operator path, POST /api/scenarios/{id}/implement, works either way.
AGENT_MAY_IMPLEMENT=true
# Lessons are stored as markdown under MEMORY_DIR/episodes and recalled for the next incident.
MEMORY_ENABLED=true
# MEMORY_DIR=/absolute/path/to/memory   (default: <repo>/memory)
# Where a model analyst reaches the MCP tools; unset = this app's server, in-process.
# MCP_URL=http://127.0.0.1:8000/mcp

# Memory and REST Analyze Response. `ignore` is a request-level control mode, not a setting:
# it stores the finished episode for the learning report but never recalls that lesson later.
# EMBEDDING_MODEL=          # unset = structured recall only
# EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
AGENT_FALLBACK_TO_MOCK=true

# NVIDIA integration. SMART_CITY_PROVIDER=nvidia uses the live Video Analytics MCP URL, or the
# development replay file when VSS_REPLAY_FILE is set. Replayed incidents are labelled vss-replay.
# NEMOTRON_BASE_URL is NIM's OpenAI-compatible endpoint; NEMOTRON_MODEL must be a model id with
# tool calling, e.g. nvidia/nemotron-3-super-120b-a12b or nvidia/nemotron-3-nano-30b-a3b.
# NVIDIA_API_KEY=
# NVIDIA_VA_MCP_URL=http://<host>:<port>/mcp
# VSS_REPLAY_FILE=simulation/scenarios/downtown_grid/vss/incidents.json
VSS_POLL_S=5
VSS_MATCH_MAX_DIST_M=40
VSS_REQUIRE_VLM_CONFIRMATION=true
VSS_DEFAULT_SEVERITY=major
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# NEMOTRON_MODEL=

# Anthropic Claude analyst and reviewer. Organization-level keys require the workspace id;
# workspace-scoped keys can leave it unset.
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=
# CLAUDE_BASE_URL=https://api.anthropic.com
# CLAUDE_MODEL=claude-haiku-4-5-20251001
